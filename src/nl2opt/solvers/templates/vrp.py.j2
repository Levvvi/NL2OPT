import json
import time

from ortools.constraint_solver import pywrapcp
from ortools.constraint_solver import routing_enums_pb2


SPEC = {{ spec_json }}


def write_solution(result):
    with open("solution.json", "w", encoding="utf-8") as output_file:
        json.dump(result, output_file, indent=2)


def main():
    start_time = time.perf_counter()

    try:
        node_names = [SPEC["depot"]] + [customer["name"] for customer in SPEC["customers"]]
        node_index_by_name = {
            node_name: node_index
            for node_index, node_name in enumerate(node_names)
        }
        distance_matrix = [
            [SPEC["distance_matrix"][from_node][to_node] for to_node in node_names]
            for from_node in node_names
        ]
        demands = [0] + [customer["demand"] for customer in SPEC["customers"]]
        vehicle_capacities = [vehicle["capacity"] for vehicle in SPEC["vehicles"]]

        manager = pywrapcp.RoutingIndexManager(
            len(node_names),
            len(SPEC["vehicles"]),
            node_index_by_name[SPEC["depot"]],
        )
        routing = pywrapcp.RoutingModel(manager)

        def distance_callback(from_index, to_index):
            from_node = manager.IndexToNode(from_index)
            to_node = manager.IndexToNode(to_index)
            return distance_matrix[from_node][to_node]

        transit_callback_index = routing.RegisterTransitCallback(distance_callback)
        routing.SetArcCostEvaluatorOfAllVehicles(transit_callback_index)

        def demand_callback(from_index):
            from_node = manager.IndexToNode(from_index)
            return demands[from_node]

        demand_callback_index = routing.RegisterUnaryTransitCallback(demand_callback)
        routing.AddDimensionWithVehicleCapacity(
            demand_callback_index,
            0,
            vehicle_capacities,
            True,
            "Capacity",
        )

        search_parameters = pywrapcp.DefaultRoutingSearchParameters()
        search_parameters.first_solution_strategy = (
            routing_enums_pb2.FirstSolutionStrategy.PATH_CHEAPEST_ARC
        )
        search_parameters.local_search_metaheuristic = (
            routing_enums_pb2.LocalSearchMetaheuristic.GUIDED_LOCAL_SEARCH
        )
        search_parameters.time_limit.seconds = 5

        assignment = routing.SolveWithParameters(search_parameters)
        if assignment is None:
            write_solution(
                {
                    "status": "INFEASIBLE",
                    "objective_value": None,
                    "solution": {
                        "routes": [],
                        "total_distance": None,
                        "total_load": None,
                        "dropped_customers": [],
                    },
                    "runtime_sec": time.perf_counter() - start_time,
                    "solver": "ortools.routing",
                    "violations": ["INFEASIBLE"],
                }
            )
            return

        routes = []
        total_distance = 0
        total_load = 0
        for vehicle_id, vehicle in enumerate(SPEC["vehicles"]):
            index = routing.Start(vehicle_id)
            stops = []
            route_distance = 0
            route_load = 0

            while not routing.IsEnd(index):
                node_index = manager.IndexToNode(index)
                node_name = node_names[node_index]
                stops.append(node_name)
                route_load += demands[node_index]
                previous_index = index
                index = assignment.Value(routing.NextVar(index))
                route_distance += routing.GetArcCostForVehicle(
                    previous_index,
                    index,
                    vehicle_id,
                )

            stops.append(node_names[manager.IndexToNode(index)])
            routes.append(
                {
                    "vehicle": vehicle["name"],
                    "stops": stops,
                    "load": route_load,
                    "distance": route_distance,
                }
            )
            total_distance += route_distance
            total_load += route_load

        write_solution(
            {
                "status": "FEASIBLE",
                "objective_value": int(assignment.ObjectiveValue()),
                "solution": {
                    "routes": routes,
                    "total_distance": total_distance,
                    "total_load": total_load,
                    "dropped_customers": [],
                },
                "runtime_sec": time.perf_counter() - start_time,
                "solver": "ortools.routing",
                "violations": [],
            }
        )
    except Exception as exc:
        write_solution(
            {
                "status": "ERROR",
                "objective_value": None,
                "solution": {},
                "runtime_sec": time.perf_counter() - start_time,
                "solver": "ortools.routing",
                "violations": [str(exc)],
            }
        )


if __name__ == "__main__":
    main()
